{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seed-agent-lab-heartbeat",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "code_update_strategy": { "mode": "immediate" },
    "bindings": [{ "name": "HEARTBEAT", "class_name": "CloudHeartbeat" }]
  },
  "migrations": [{ "tag": "heartbeat-v1", "new_sqlite_classes": ["CloudHeartbeat"] }],
  "vars": { "HEARTBEAT_ENABLED": "true", "MOMOAI_MODEL": "momo_278", "DAILY_CHAT_LIMIT": "50" },
  "observability": { "enabled": false }
}
