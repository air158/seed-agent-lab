{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seed-agent-lab-heartbeat",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "HEARTBEAT", "class_name": "CloudHeartbeat" }]
  },
  "migrations": [{ "tag": "heartbeat-v1", "new_sqlite_classes": ["CloudHeartbeat"] }],
  "vars": { "HEARTBEAT_ENABLED": "true" },
  "observability": { "enabled": false }
}
